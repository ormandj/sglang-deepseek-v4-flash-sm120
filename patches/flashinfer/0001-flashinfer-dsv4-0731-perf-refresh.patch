+__device__ __forceinline__ uint32_t clear_pos_zero_u16x2(uint32_t raw) {
+  uint32_t lo = raw & 0xffffu;
+  uint32_t hi = raw & 0xffff0000u;
+  if (lo == 0u) {
+    lo = 0x8000u;
+  }
+  if (hi == 0u) {
+    hi = 0x80000000u;
+  }
+  return hi | lo;
+}
