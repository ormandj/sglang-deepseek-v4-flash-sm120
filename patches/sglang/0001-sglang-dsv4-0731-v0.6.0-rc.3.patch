+    def test_ordinary_serving_shapes_run_in_one_launch(self):
+        """The guard must not split allocations that fit.
+
+        The shapes below are a TP2 96 GiB deployment at
+        ``--mem-fraction-static 0.95`` with ``--chunked-prefill-size 8192``:
+        max_c4_seq_len is the batch's padded C4 context, so it grows with the
+        request. Splitting these cost 22% of cold-prefill throughput at 64K.
+        """
+        total_memory = 96 * (1 << 30)
+        free_memory = 1.4 * (1 << 30)
+        device_properties = SimpleNamespace(total_memory=total_memory)
+        # (request tokens, max_c4_seq_len, expected chunks)
+        cases = (
+            (8_192, 2_112, 1),
+            (32_768, 8_256, 1),
+            (65_536, 16_448, 1),
+            (131_072, 32_832, 1),
+            (385_536, 96_512, 3),
+        )
+        for request_tokens, max_c4_seq_len, expected_chunks in cases:
+            with (
+                self.subTest(request_tokens=request_tokens),
+                patch(f"{_INDEXER}.get_schedule") as get_schedule,
+                patch(
+                    "torch.cuda.get_device_properties",
+                    return_value=device_properties,
+                ),
+                patch(
+                    "torch.cuda.mem_get_info",
+                    return_value=(int(free_memory), total_memory),
+                ),
+                patch(f"{_INDEXER}.get_is_capture_mode", return_value=False),
+            ):
+                C4IndexerBackendMixin._paged_mqa_logits_budget_bytes.clear()
+                get_schedule.return_value.mem_fraction_static = 0.95
+                query_rows = min(request_tokens, 8_192)
+                max_rows = C4IndexerBackendMixin._get_paged_mqa_logits_max_rows(
+                    query_rows=query_rows,
+                    max_c4_seq_len=max_c4_seq_len,
+                    device_index=0,
+                )
+            chunks = -(-query_rows // max_rows)
+            self.assertEqual(chunks, expected_chunks)
