 class TestFlashInferCommFusion(unittest.TestCase):
+    def test_preinitialized_workspace_covers_largest_prefill_forward(self):
+        from sglang.srt.model_executor.runner.base_runner import BaseRunner
+
+        cases = (
+            (8192, False, 16384, 8192),
+            (8192, True, 16384, 16384),
+            (-1, False, 16384, 16384),
+        )
+        for (
+            chunked_prefill_size,
+            enable_dynamic_chunking,
+            max_prefill_tokens,
+            expected,
+        ) in cases:
+            with self.subTest(
+                chunked_prefill_size=chunked_prefill_size,
+                enable_dynamic_chunking=enable_dynamic_chunking,
+            ):
+                model_runner = types.SimpleNamespace(
+                    server_args=types.SimpleNamespace(
+                        flashinfer_allreduce_fusion_backend="auto",
+                        chunked_prefill_size=chunked_prefill_size,
+                        enable_dynamic_chunking=enable_dynamic_chunking,
+                        max_prefill_tokens=max_prefill_tokens,
+                    ),
+                    model_config=types.SimpleNamespace(hidden_size=4096),
+                    dtype=torch.bfloat16,
+                )
+                runner = types.SimpleNamespace(model_runner=model_runner)
+
+                with patch(
+                    "sglang.srt.layers.flashinfer_comm_fusion.pre_initialize_workspaces"
+                ) as pre_initialize:
+                    BaseRunner._pre_initialize_flashinfer_allreduce_workspace(runner)
+
+                pre_initialize.assert_called_once_with(
+                    max_token_num=expected,
+                    hidden_dim=4096,
+                    dtype=torch.bfloat16,
+                )
+
